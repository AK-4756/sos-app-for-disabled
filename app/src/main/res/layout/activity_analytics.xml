<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ProgressBar android:id="@+id/pbAnalytics"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:visibility="visible"
            android:layout_marginBottom="8dp" />

        <!-- ── Summary cards grid ────────────────────────────────────────── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">

            <!-- Total -->
            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="80dp" android:layout_weight="1" android:layout_marginEnd="4dp"
                app:cardCornerRadius="10dp" app:cardBackgroundColor="#E53935"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvAnalyticsTotal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/analytics_total" android:textSize="10sp" android:textColor="#EEE" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Resolved -->
            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="80dp" android:layout_weight="1" android:layout_marginStart="4dp"
                app:cardCornerRadius="10dp" app:cardBackgroundColor="#43A047"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvAnalyticsResolved"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/analytics_resolved" android:textSize="10sp" android:textColor="#EEE" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">

            <!-- False -->
            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="80dp" android:layout_weight="1" android:layout_marginEnd="4dp"
                app:cardCornerRadius="10dp" app:cardBackgroundColor="#757575"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvAnalyticsFalse"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/analytics_false" android:textSize="10sp" android:textColor="#EEE" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Avg Response -->
            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="80dp" android:layout_weight="1" android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="10dp" app:cardBackgroundColor="#1E88E5"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvAnalyticsResponse"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/analytics_response_time" android:textSize="10sp" android:textColor="#EEE" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Active Volunteers -->
            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="80dp" android:layout_weight="1" android:layout_marginStart="4dp"
                app:cardCornerRadius="10dp" app:cardBackgroundColor="#8E24AA"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvAnalyticsVolunteers"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/analytics_volunteers" android:textSize="10sp" android:textColor="#EEE" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ── Trigger Pie Chart ──────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            app:cardCornerRadius="10dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="SOS Trigger Types" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" android:paddingBottom="8dp" />
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartTriggers"
                    android:layout_width="match_parent" android:layout_height="220dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Hourly Bar Chart ───────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            app:cardCornerRadius="10dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Alerts by Hour of Day" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" android:paddingBottom="8dp" />
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartHourly"
                    android:layout_width="match_parent" android:layout_height="200dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Location Hotspots ──────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Campus Hotspots" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" android:paddingBottom="8dp" />
                <TextView android:id="@+id/tvAnalyticsHotspots"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="?android:attr/textColorSecondary"
                    android:fontFamily="monospace" android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>

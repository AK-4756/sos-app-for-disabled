<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:padding="16dp">

    <!-- ── Header row ──────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="@string/cd_voice_idle"
            android:importantForAccessibility="yes"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:tint="?android:attr/textColorPrimary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvContactCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_loading"
        android:textSize="16sp"
        android:textColor="#FFD600"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:importantForAccessibility="yes"
        android:focusable="true" />

    <Spinner
        android:id="@+id/spinnerLocation"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="Select location for SOS alert"
        android:importantForAccessibility="yes" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="18sp"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:importantForAccessibility="yes"
        android:accessibilityLiveRegion="polite" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5"
        android:textColor="#FF5252"
        android:textSize="80sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:importantForAccessibility="yes"
        android:accessibilityLiveRegion="assertive" />

    <ProgressBar
        android:id="@+id/progressCountdown"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginBottom="16dp"
        android:progressTint="#FF5252"
        android:progressBackgroundTint="?android:attr/textColorSecondary"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="no">

        <Button
            android:id="@+id/btnSOS"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:text="@string/sos_button_label"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold"
            android:background="@drawable/sos_button_bg"
            android:contentDescription="@string/cd_sos_button"
            android:stateListAnimator="@null"
            android:elevation="8dp"
            android:importantForAccessibility="yes"
            android:focusable="true" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        android:text="@string/cancel_button_label"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/cancel_button_bg"
        android:contentDescription="@string/cd_cancel_button"
        android:visibility="gone"
        android:importantForAccessibility="yes"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvShakeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_shake"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="2dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvVolumeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_volume"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_voice"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/panelPanic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/surfaceColor"
        android:padding="12dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/panic_timer_label"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvPanicCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60"
                android:textColor="#FF5252"
                android:textSize="22sp"
                android:textStyle="bold"
                android:contentDescription="@string/panic_timer_cd_desc"
                android:importantForAccessibility="yes"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="s"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:paddingStart="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <Button
            android:id="@+id/btnImSafe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="@string/btn_im_safe"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:backgroundTint="#69F0AE"
            android:contentDescription="@string/btn_im_safe" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCheckIn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="4dp"
        android:text="@string/btn_checkin_ok"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565C0"
        android:visibility="gone"
        android:contentDescription="@string/btn_checkin_ok" />

</LinearLayout>

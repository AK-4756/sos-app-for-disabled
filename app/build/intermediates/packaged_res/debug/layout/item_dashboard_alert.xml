<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/surfaceColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: user name + trigger + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDashUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvDashTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <!-- Status badge -->
                <TextView
                    android:id="@+id/tvDashStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/sos_button_bg" />

                <TextView
                    android:id="@+id/tvDashTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: location -->
        <TextView
            android:id="@+id/tvDashLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary"
            android:drawablePadding="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Row 3: battery + delivered + responder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvDashBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/tvDashDelivered"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDashResponder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#1E88E5"
            android:textStyle="italic"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDashAck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ Ack"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FB8C00"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:contentDescription="Acknowledge alert" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDashAssign"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Assign"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8E24AA"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:contentDescription="Assign yourself as responder" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDashOnTheWay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚗 Way"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00ACC1"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:contentDescription="Mark on the way" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDashResolve"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✅"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#43A047"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:contentDescription="Mark resolved" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDashFalseAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠ False"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#757575"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:contentDescription="Mark as false alert" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDashMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗺"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F"
                android:visibility="gone"
                android:contentDescription="Open location in Maps" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

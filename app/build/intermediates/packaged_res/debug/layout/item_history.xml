<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/surfaceColor"
    android:padding="14dp">

    <!-- Date / time -->
    <TextView
        android:id="@+id/tvHistDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <!-- Trigger type -->
        <TextView
            android:id="@+id/tvHistTrigger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <!-- Status (colour-coded in Java) -->
        <TextView
            android:id="@+id/tvHistStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!-- Contacts notified + battery + location hint -->
    <TextView
        android:id="@+id/tvHistDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginTop="2dp" />

</LinearLayout>

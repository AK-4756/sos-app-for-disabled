<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Section: Theme ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dark Mode"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Countdown ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_countdown_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <RadioGroup
                android:id="@+id/rgCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <RadioButton android:id="@+id/rb3s"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/countdown_3s" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" />

                <RadioButton android:id="@+id/rb5s"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/countdown_5s" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" android:checked="true" />

                <RadioButton android:id="@+id/rb10s"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/countdown_10s" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" />
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Custom Message ────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_message_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_message_hint"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/etCustomMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorHint"
            android:hint="@string/setting_message_placeholder"
            android:layout_marginBottom="16dp" />

        <!-- ── Section: Text Size ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_text_size_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <RadioGroup
                android:id="@+id/rgTextSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <RadioButton android:id="@+id/rbNormalText"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/text_size_normal" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:checked="true" android:gravity="center_vertical" />

                <RadioButton android:id="@+id/rbLargeText"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/text_size_large" android:textSize="20sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" />
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Voice / TTS ───────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_tts_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_tts_label"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchTts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/dividerVertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_speech_rate"
                        android:textSize="16sp" android:textColor="?android:attr/textColorPrimary" />
                    <TextView
                        android:id="@+id/tvSpeechRateLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/rate_normal"
                        android:textSize="14sp" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekSpeechRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="50" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTestTts"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_test_tts" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Language ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_language_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <RadioGroup
                android:id="@+id/rgLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <RadioButton android:id="@+id/rbLangEn"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/lang_english" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" />

                <RadioButton android:id="@+id/rbLangHi"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/lang_hindi" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" />
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Shake Trigger ─────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_shake_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_shake_label"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchShake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Silent SOS ───────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_silent_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_silent_subtitle"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_silent_label"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSilentMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Volume Button Trigger ────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_volume_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_volume_subtitle"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_volume_label"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOpenAccessibility"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_open_accessibility" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_volume_instruction"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Auto-SOS / Panic Timer ───────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_autoSos_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_panic_duration"
                        android:textSize="16sp" android:textColor="?android:attr/textColorPrimary" />
                    <TextView
                        android:id="@+id/tvPanicDurationLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="60s"
                        android:textSize="14sp" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekPanicDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="6"
                    android:progress="2" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/dividerVertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_checkin_label"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCheckIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_checkin_interval"
                        android:textSize="16sp" android:textColor="?android:attr/textColorPrimary" />
                    <TextView
                        android:id="@+id/tvCheckInIntervalLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="30 min"
                        android:textSize="14sp" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekCheckInInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="5"
                    android:progress="1" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: User Mode ────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_user_mode_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_user_mode_subtitle"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="16dp">

            <RadioGroup
                android:id="@+id/rgUserMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <RadioButton android:id="@+id/rbModeDefault"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/mode_default" android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:checked="true" android:gravity="center_vertical" />

                <RadioButton android:id="@+id/rbModeVision"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/mode_vision" android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" />

                <RadioButton android:id="@+id/rbModeHearing"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/mode_hearing" android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" />

                <RadioButton android:id="@+id/rbModeMotor"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/mode_motor" android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center_vertical" />
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <!-- ── Section: Smart Escalation Delay ───────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_escalation_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/surfaceColor"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_escalation_label"
                        android:textSize="16sp" android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:id="@+id/tvEscalationDelayLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="60s"
                        android:textSize="14sp" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekEscalationDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="5"
                    android:progress="2" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- ── Save ───────────────────────────────────────────────────────── -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/btn_save_settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="?attr/colorPrimary"
            android:contentDescription="@string/btn_save_settings" />

    </LinearLayout>
</ScrollView>
